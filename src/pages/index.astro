---
import StatusCard from '../components/StatusCard.astro';
import WeekView from '../components/WeekView.astro';
import Calendar from '../components/Calendar.astro';
import BestDays from '../components/BestDays.astro';
import ShipDrawer from '../components/ShipDrawer.astro';
import WeatherStrip from '../components/WeatherStrip.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import { getToday, getRange, getMonth, generatedAt } from '../lib/schedule';
import { getBestDays } from '../lib/bestDays';
import '../styles/global.css';

const today = getToday();
const weekDays = getRange(today.date, 14);
const now = new Date(today.date + 'T12:00:00Z');
const thisMonth = getMonth(now.getUTCFullYear(), now.getUTCMonth() + 1);
const nextMonthDate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + 1, 1));
const nextMonth = getMonth(nextMonthDate.getUTCFullYear(), nextMonthDate.getUTCMonth() + 1);
const bestDays = getBestDays(today.date, { count: 5 });

const generatedDate = new Date(generatedAt);
const daysSinceUpdate = Math.floor((Date.now() - generatedDate.getTime()) / 86400000);
const dataIsStale = daysSinceUpdate > 14;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Is today a good day to visit Ålesund? Check cruise ship traffic before you go." />
  <meta name="theme-color" content="#10b981" />
  <title>Visit Ålesund — Is it busy today?</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen">
  <div class="max-w-lg mx-auto px-4 py-6 pb-24 space-y-8">

    <!-- Header -->
    <header class="flex items-center justify-between gap-2">
      <div class="min-w-0">
        <h1 class="text-xl font-bold text-gray-900">Visit Ålesund</h1>
        <p class="text-sm text-gray-500" data-i18n="subtitle">Cruise traffic tracker</p>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <LangSwitcher />
        <a
          href="https://alesund.havn.no/skipstrafikk/webkamera/alesund-havn-syd/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-blue-600 hover:underline flex items-center gap-1"
          aria-label="Live harbor webcam"
          data-i18n-webcam
        >
          📷 <span data-i18n="webcam">Webcam</span>
        </a>
      </div>
    </header>

    <!-- PWA install bar (hidden until browser signals installability) -->
    <div
      id="pwa-install-bar"
      hidden
      class="flex items-center justify-between bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3"
    >
      <div class="flex items-center gap-3">
        <span class="text-2xl">📲</span>
        <div>
          <p class="text-sm font-semibold text-emerald-800" id="pwa-install-title">Install app</p>
          <p class="text-xs text-emerald-600" id="pwa-install-hint">Works offline · No app store needed</p>
        </div>
      </div>
      <button
        id="pwa-install-btn"
        class="bg-emerald-600 text-white text-xs font-bold px-4 py-2 rounded-full hover:bg-emerald-700 active:scale-95 transition flex-shrink-0"
      >Install</button>
    </div>

    <!-- Today's Status -->
    <section>
      <StatusCard day={today} />
    </section>

    <!-- Share button -->
    <div class="flex justify-end">
      <button
        id="share-btn"
        class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-800 transition"
      >
        <span data-i18n="share">Share today's status</span>
        <span>↗</span>
      </button>
    </div>

    <!-- Weather -->
    <section>
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3" data-i18n="section_weather">Weather forecast</h2>
      <WeatherStrip />
    </section>

    <!-- 14-day strip -->
    <section>
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3" data-i18n="section_14days">Next 14 days</h2>
      <WeekView days={weekDays} />
    </section>

    <!-- Best days to visit -->
    <section>
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3" data-i18n="section_bestdays">Best upcoming days</h2>
      <BestDays days={bestDays} />
    </section>

    <!-- Calendar -->
    <section>
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3" data-i18n="section_calendar">Calendar</h2>
      <div class="bg-white rounded-2xl p-4 shadow-sm space-y-6">
        <Calendar
          days={thisMonth}
          year={now.getUTCFullYear()}
          month={now.getUTCMonth() + 1}
        />
        <div class="border-t border-gray-100 pt-4">
          <Calendar
            days={nextMonth}
            year={nextMonthDate.getUTCFullYear()}
            month={nextMonthDate.getUTCMonth() + 1}
          />
        </div>
      </div>

      <!-- Legend -->
      <div class="flex flex-wrap gap-x-4 gap-y-1 mt-3 text-xs text-gray-500">
        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span> <span data-i18n="legend_quiet">Quiet</span></span>
        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-yellow-400 inline-block"></span> <span data-i18n="legend_moderate">Moderate (1 ship)</span></span>
        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-orange-500 inline-block"></span> <span data-i18n="legend_busy">Busy (2 ships)</span></span>
        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span> <span data-i18n="legend_very_busy">Very busy (3+)</span></span>
      </div>
    </section>

    <!-- Footer -->
    <footer class="text-center space-y-1 pt-2">
      <p
        id="footer-updated"
        data-days={daysSinceUpdate}
        data-stale={dataIsStale}
        class={`text-xs ${dataIsStale ? 'text-orange-500' : 'text-gray-400'}`}
      >
        {daysSinceUpdate === 0
          ? `Schedule updated today${dataIsStale ? ' — may be outdated' : ''}`
          : `Schedule updated ${daysSinceUpdate} day${daysSinceUpdate > 1 ? 's' : ''} ago${dataIsStale ? ' — may be outdated' : ''}`}
      </p>
      <p class="text-xs text-gray-400">
        <span data-i18n="footer_data">Data:</span>
        <a href="https://alesund.havn.no/skipstrafikk/mooringplan-cruise/" class="underline hover:text-gray-600 ml-1" target="_blank" rel="noopener">Ålesund Havn</a>
      </p>
      <p class="text-xs text-gray-400" data-i18n="footer_credit">Made in Norway 🇳🇴 by JacosVerksted</p>
    </footer>

  </div>

  <!-- Ship info drawer -->
  <ShipDrawer />

  <script>
    import { getCapacity } from '../lib/ships';

