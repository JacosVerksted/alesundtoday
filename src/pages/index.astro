    const AUTHOR_LINK_HTML = '<a href="https://github.com/JacosVerksted" class="underline hover:text-gray-600" target="_blank" rel="noopener">JacosVerksted</a>';

    // ── Apply language ────────────────────────────────────────────────────────
    function applyLang(lang: Lang) {
      const t = T[lang] ?? T.en;
      localStorage.setItem('lang', lang);
      document.documentElement.lang = lang === 'en' ? 'en' : 'no';

      // Simple keyed translations
      const STATIC_KEYS: (keyof Strings)[] = [
        'subtitle','intro','webcam','share','section_weather','section_14days',
        'section_bestdays','section_calendar','legend_quiet','legend_moderate',
        'legend_busy','legend_very_busy','footer_data','footer_weather','footer_disclaimer','footer_privacy_note','footer_privacy_link','offseason_note','bestdays_none','footer_credit',
        'level_quiet','level_moderate','level_busy','level_very_busy','level_unknown','unknown_note','legend_unknown',
        'no_quiet_days','drawer_capacity_label','drawer_visitors_label','drawer_footnote',
        'badge_quiet','badge_moderate','badge_busy','will_be','back_to_today',
      ];
      STATIC_KEYS.forEach((key) => {
        document.querySelectorAll<HTMLElement>(`[data-i18n="${key}"]`).forEach((el) => {
          const val = t[key];
          if (typeof val !== 'string') return;
          // The credit line links the author's name to their GitHub page
          if (key === 'footer_credit') el.innerHTML = val.replace('JacosVerksted', AUTHOR_LINK_HTML);
          else el.textContent = val;
        });
      });

      // "In port 07:00–21:00"
      document.querySelectorAll<HTMLElement>('[data-i18n-inport]').forEach((el) => {
        const w = el.dataset.window ?? '';
        el.textContent = w ? `${t.in_port} ${w}` : '';
      });

      // Ships-in-port count
      document.querySelectorAll<HTMLElement>('[data-i18n-ships]').forEach((el) => {
        const n = parseInt(el.dataset.count ?? '0', 10);
        el.textContent = n === 0 ? t.ships_none : n === 1 ? t.ships_one : t.ships_many(n);
      });

      // Long date (StatusCard header)
      document.querySelectorAll<HTMLElement>('[data-i18n-date-long]').forEach((el) => {
        const d = new Date((el.dataset.date ?? '') + 'T12:00:00Z');
        el.textContent = d.toLocaleDateString(t.date_locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
      });

      // Short date (BestDays rows)
      document.querySelectorAll<HTMLElement>('[data-i18n-date-short]').forEach((el) => {
        const d = new Date((el.dataset.date ?? '') + 'T12:00:00Z');
        el.textContent = d.toLocaleDateString(t.date_locale, { weekday: 'short', day: 'numeric', month: 'short' });
      });

      // Weekday abbreviations in WeekView
      document.querySelectorAll<HTMLElement>('[data-i18n-weekday]').forEach((el) => {
        const d = new Date((el.dataset.date ?? '') + 'T12:00:00Z');
        el.textContent = d.toLocaleDateString(t.date_locale, { weekday: 'short' });
      });

      // Calendar weekday headers (Mon–Sun)
      document.querySelectorAll<HTMLElement>('[data-i18n-cal-weekday]').forEach((el) => {
        const idx = parseInt(el.dataset.wdIndex ?? '0', 10);
        el.textContent = t.weekdays[idx] ?? '';
      });

      // Calendar month labels
      document.querySelectorAll<HTMLElement>('[data-i18n-month]').forEach((el) => {
        const y = parseInt(el.dataset.year ?? '2026', 10);
        const m = parseInt(el.dataset.month ?? '1', 10);
        const d = new Date(Date.UTC(y, m - 1, 1));
        el.textContent = d.toLocaleDateString(t.month_locale, { month: 'long', year: 'numeric' });
      });

      // Ship count label in WeekView strips
      const shipWord: Record<Lang, (n: number) => string> = {
        en: (n) => `${n} ${n === 1 ? 'ship' : 'ships'}`,
        nb: (n) => `${n} skip`,
        nn: (n) => `${n} skip`,
        de: (n) => `${n} ${n === 1 ? 'Schiff' : 'Schiffe'}`,
        nl: (n) => `${n} ${n === 1 ? 'schip' : 'schepen'}`,
        fr: (n) => `${n} ${n === 1 ? 'navire' : 'navires'}`,
      };
      document.querySelectorAll<HTMLElement>('[data-i18n-skipcount]').forEach((el) => {
        const n = parseInt(el.dataset.count ?? '0', 10);
        el.textContent = shipWord[lang](n);
      });

      // BestDays reason strings
      document.querySelectorAll<HTMLElement>('[data-i18n-reason]').forEach((el) => {
        const n = parseInt(el.dataset.count ?? '0', 10);
        const v = parseInt(el.dataset.visitors ?? '0', 10);
        el.textContent = n === 0 ? t.best_quiet : n === 1 ? t.best_one(v) : t.best_many(n, v);
      });

      // BestDays badges
      document.querySelectorAll<HTMLElement>('[data-i18n-badge]').forEach((el) => {
        const level = el.dataset.level ?? '';
        el.textContent = level === 'quiet' ? t.badge_quiet : level === 'moderate' ? t.badge_moderate : t.badge_busy;
      });

      // Footer update timestamp
      const footerEl = document.getElementById('footer-updated');
      if (footerEl) {
        const days = parseInt(footerEl.dataset.days ?? '0', 10);
        const stale = footerEl.dataset.stale === 'true';
        const base = days === 0 ? t.footer_updated_today : t.footer_updated_ago(days);
        footerEl.textContent = base + (stale ? t.footer_stale : '');
      }
    }

    // ── Boot ──────────────────────────────────────────────────────────────────
    const initLang = getLang();
    applyLang(initLang);

    window.addEventListener('langchange', (e) => {
      applyLang((e as CustomEvent<{ lang: Lang }>).detail.lang);
    });

    // ── Service worker ────────────────────────────────────────────────────────
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }

    // ── Share button ──────────────────────────────────────────────────────────
    const shareBtn = document.getElementById('share-btn');
    shareBtn?.addEventListener('click', async () => {
      const url = location.href;
      const lang = getLang();
      const t = T[lang] ?? T.en;
      const shareSpan = shareBtn.querySelector<HTMLElement>('[data-i18n="share"]');
      if (navigator.share) {
        try { await navigator.share({ title: 'Visit Ålesund', url }); return; } catch {}
      }
      try {
        await navigator.clipboard.writeText(url);
        if (shareSpan) {
          const orig = shareSpan.textContent ?? '';
          shareSpan.textContent = t.link_copied;
          setTimeout(() => { shareSpan.textContent = orig; }, 2000);
        }
      } catch {}
    });

    // ── Deep link ─────────────────────────────────────────────────────────────
    const dateParam = new URLSearchParams(location.search).get('date');
    if (dateParam) {
      const el = document.querySelector(`a[href="?date=${dateParam}"]`);
      if (el) {
        el.classList.add('ring-2', 'ring-blue-500', 'ring-offset-1');
        setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
      }
    }

    // ── PWA install ───────────────────────────────────────────────────────────
    const INSTALL_I18N: Record<string, { title: string; hint: string; btn: string }> = {
      en: { title: 'Install app',        hint: 'Works offline · No app store needed',       btn: 'Install'     },
      nb: { title: 'Installer app',      hint: 'Fungerer uten nett · Ingen app-butikk',     btn: 'Installer'   },
      nn: { title: 'Installer app',      hint: 'Fungerer utan nett · Ingen app-butikk',     btn: 'Installer'   },
      de: { title: 'App installieren',   hint: 'Offline nutzbar · Kein App Store nötig',    btn: 'Installieren'},
      nl: { title: 'App installeren',    hint: 'Werkt offline · Geen app store nodig',      btn: 'Installeren' },
      fr: { title: "Installer l'appli",  hint: 'Fonctionne hors ligne · Sans app store',    btn: 'Installer'   },
    };

    const installBar   = document.getElementById('pwa-install-bar')!;
    const installBtn   = document.getElementById('pwa-install-btn') as HTMLButtonElement;
    const installTitle = document.getElementById('pwa-install-title')!;
    const installHint  = document.getElementById('pwa-install-hint')!;

    function setInstallStrings(lang: string) {
      const s = INSTALL_I18N[lang] ?? INSTALL_I18N.en;
      installTitle.textContent = s.title;
      installHint.textContent  = s.hint;
      installBtn.textContent   = s.btn;
    }
    setInstallStrings(initLang);
    window.addEventListener('langchange', (e) =>
      setInstallStrings((e as CustomEvent<{ lang: string }>).detail.lang)
    );

    // iOS: no beforeinstallprompt — show Share sheet guidance instead
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches
      || (navigator as any).standalone === true;
    const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent) && !isStandalone;
    if (isIOS) {
      installBar.hidden = false;
      installTitle.textContent = 'Add to Home Screen';
      installHint.textContent  = 'Tap Share  →  Add to Home Screen';
      installBtn.style.display = 'none';
    }

    // Chrome / Android / Edge: capture the native prompt
    let deferredPrompt: (Event & { prompt(): void; userChoice: Promise<{ outcome: string }> }) | null = null;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e as any;
      installBar.hidden = false;
      setInstallStrings(getLang());
    });

    installBtn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      deferredPrompt = null;
      if (outcome === 'accepted') installBar.hidden = true;
    });

    window.addEventListener('appinstalled', () => {
      installBar.hidden = true;
      deferredPrompt = null;
    });

    // ── Day selection + live date refresh ─────────────────────────────────────
    // Below: a shared schedule cache and a status-card renderer, reused for
    // both day selection and the daily date-rollover repaint of the top card.
    // Shared schedule cache + status-card renderer (used by day selection and
    // the date-rollover refresh below).
    type Call = { date: string; ships: string[]; count: number; level: string; visits?: Visit[] };
    let scheduleCache: Call[] | null = null;
    // Latest published call date; later future dates are "not published yet"
    let scheduleHorizon = '';
    async function loadSchedule(): Promise<Call[]> {
      if (scheduleCache) return scheduleCache;
      try {
        const res = await fetch('/schedule.json');
        const data = await res.json();
        scheduleCache = (data.calls ?? []) as Call[];
        scheduleHorizon = computeHorizon(scheduleCache.map((c) => c.date), data.generated ?? new Date().toISOString());
      } catch {
        scheduleCache = [];
      }
      return scheduleCache;
    }

    function localTodayISO(): string {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }

    type Level = 'quiet' | 'moderate' | 'busy' | 'very-busy' | 'unknown';

    // Mirrors getDay() in src/lib/schedule.ts: a future date past the last
    // published call has no schedule yet; everything else without a call is quiet.
    function levelFor(dateISO: string, call: Call | undefined): Level {
      if (call) return call.level as Level;
      return dateISO > localTodayISO() && dateISO > scheduleHorizon ? 'unknown' : 'quiet';
    }
    const LEVEL_CFG: Record<Level, { bg: string; ring: string; dot: string; text: string; key: string }> = {
      quiet:       { bg: 'bg-emerald-50', ring: 'ring-emerald-200', dot: 'bg-emerald-500', text: 'text-emerald-700', key: 'level_quiet' },
      moderate:    { bg: 'bg-yellow-50',  ring: 'ring-yellow-200',  dot: 'bg-yellow-400',  text: 'text-yellow-700',  key: 'level_moderate' },
      busy:        { bg: 'bg-orange-50',  ring: 'ring-orange-200',  dot: 'bg-orange-500',  text: 'text-orange-700',  key: 'level_busy' },
      'very-busy': { bg: 'bg-red-50',     ring: 'ring-red-200',     dot: 'bg-red-500',     text: 'text-red-700',     key: 'level_very_busy' },
      unknown:     { bg: 'bg-gray-50',    ring: 'ring-gray-200',    dot: 'bg-gray-300',    text: 'text-gray-500',    key: 'level_unknown' },
    };
    const ALL_BG   = ['bg-emerald-50','bg-yellow-50','bg-orange-50','bg-red-50','bg-gray-50'];
    const ALL_RING = ['ring-emerald-200','ring-yellow-200','ring-orange-200','ring-red-200','ring-gray-200'];
    const ALL_DOT  = ['bg-emerald-500','bg-yellow-400','bg-orange-500','bg-red-500','bg-gray-300'];
    const ALL_TEXT = ['text-emerald-700','text-yellow-700','text-orange-700','text-red-700','text-gray-500'];

    // Repaint the top status card for an arbitrary date. When the date is not
    // today, an "It will be" eyebrow and a "back to today" button appear so it's
    // clear you're previewing a different day.
    function renderStatusCard(dateStr: string, calls: Call[], isToday: boolean) {
      const call  = calls.find(c => c.date === dateStr);
      const ships = call?.ships ?? [];
      const count = call?.count ?? 0;
      const level = levelFor(dateStr, call);
      const cfg   = LEVEL_CFG[level];

      const section = document.querySelector<HTMLElement>('section.rounded-2xl');
      if (!section) return;

      const dateEl = section.querySelector<HTMLElement>('[data-i18n-date-long]');
      if (dateEl) dateEl.dataset.date = dateStr;

      [...ALL_BG, ...ALL_RING].forEach(c => section.classList.remove(c));
      section.classList.add(cfg.bg, cfg.ring);

      const circle = section.querySelector<HTMLElement>('div.rounded-full.flex-shrink-0');
      if (circle) {
        ALL_DOT.forEach(c => circle.classList.remove(c));
        circle.classList.add(cfg.dot);
      }

      const heading = section.querySelector<HTMLElement>('h2[data-i18n]');
      if (heading) {
        heading.dataset.i18n = cfg.key;
        ALL_TEXT.forEach(c => heading.classList.remove(c));
        heading.classList.add(cfg.text);
      }

      // Sub-line: ship count, or the "not published yet" note for unknown days
      const countEl = section.querySelector<HTMLElement>('[data-i18n-ships], [data-i18n="unknown_note"]');
      if (countEl) {
        if (level === 'unknown') {
          delete countEl.dataset.i18nShips;
          countEl.dataset.i18n = 'unknown_note';
        } else {
          delete countEl.dataset.i18n;
          countEl.dataset.i18nShips = '';
          countEl.dataset.count = String(count);
        }
      }

      // "In port 07:00–21:00" summary, from the port's mooring plan when available
      const visits = call?.visits ?? [];
      const inPort = document.getElementById('status-inport');
      if (inPort) {
        const window = portWindow(visits);
        inPort.hidden = !window;
        inPort.dataset.window = window;
      }

      section.querySelector('.flex.flex-wrap.gap-2')?.remove();
      section.querySelector('.visit-times')?.remove();
      if (ships.length > 0) {
        const div = document.createElement('div');
        div.className = 'flex flex-wrap gap-2';
        ships.forEach(ship => {
          const cap = getCapacity(ship);
          const btn = document.createElement('button');
          btn.className = 'ship-chip inline-flex items-center gap-1.5 rounded-full bg-white/70 backdrop-blur px-3 py-1.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-white transition min-h-[44px]';
          btn.dataset.ship = ship;
          btn.dataset.capacity = cap !== null ? String(cap) : '';
          btn.setAttribute('aria-label', `View details for ${ship}`);
          // Built with textContent, not innerHTML: ship names come from scraped data
          const icon = document.createElement('span'); icon.textContent = '\u{1F6A2}';
          const name = document.createElement('span'); name.textContent = ship;
          btn.append(icon, name);
          if (cap !== null) {
            const capEl = document.createElement('span');
            capEl.className = 'text-gray-400 text-xs';
            capEl.textContent = `\u00B7\u00A0${(cap / 1000).toFixed(1)}k pax`;
            btn.append(capEl);
          }
          div.appendChild(btn);
        });
        section.appendChild(div);
      }
      if (visits.length > 0) {
        const ul = document.createElement('ul');
        ul.className = 'visit-times mt-3 space-y-1 text-sm text-gray-600';
        visits.forEach(v => {
          const li = document.createElement('li');
          const time = document.createElement('span'); time.className = 'font-medium tabular-nums text-gray-700'; time.textContent = timeRange(v.eta, v.etd);
          const ship = document.createElement('span'); ship.textContent = ` ${v.ship}`;
          const bay = document.createElement('span'); bay.className = 'text-gray-400'; bay.textContent = ` \u00B7 ${v.bay}`;
          li.append(time, ship, bay);
          ul.appendChild(li);
        });
        section.appendChild(ul);
      }

      const eyebrow = document.getElementById('status-eyebrow');
      const backBtn = document.getElementById('back-to-today');
      if (eyebrow) eyebrow.hidden = isToday;
      if (backBtn) backBtn.hidden = isToday;

      applyLang(getLang());
    }

    // Day selection: clicking any day in the calendar or the 14-day strip
    // repaints the top status card. A blue outline marks the chosen day
    // (distinct from the box-ring that marks today).
    function highlightSelectedDay(dateStr: string, isToday: boolean) {
      document.querySelectorAll<HTMLElement>('[data-day-select]').forEach(el => {
        el.classList.toggle('selected-day', !isToday && el.dataset.daySelect === dateStr);
      });
    }

    async function selectDay(dateStr: string) {
      const calls = await loadSchedule();
      const isToday = dateStr === localTodayISO();
      renderStatusCard(dateStr, calls, isToday);
      highlightSelectedDay(dateStr, isToday);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Delegated so it keeps working after the 14-day strip is rebuilt below
    document.addEventListener('click', (e) => {
      const el = (e.target as Element).closest<HTMLElement>('[data-day-select]');
      if (el?.dataset.daySelect) selectDay(el.dataset.daySelect);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const el = (e.target as Element).closest<HTMLElement>('[data-day-select]');
      if (el?.dataset.daySelect) { e.preventDefault(); selectDay(el.dataset.daySelect); }
    });
    document.getElementById('back-to-today')?.addEventListener('click', () => selectDay(localTodayISO()));

    (async () => {
      const todayStr = localTodayISO();
      const dateEl = document.querySelector<HTMLElement>('[data-i18n-date-long]');
      if (!dateEl || dateEl.dataset.date === todayStr) return; // already correct

      const calls = await loadSchedule();

      // Repaint the status card for the real today
      renderStatusCard(todayStr, calls, true);

      // Rebuild WeekView strip for the correct 14-day window
      const weekContainer = document.getElementById('weekview-strip');
      if (weekContainer) {
        const wkBg: Record<string, string> = {
          quiet:      'bg-emerald-100 border-emerald-200',
          moderate:   'bg-yellow-100 border-yellow-200',
          busy:       'bg-orange-100 border-orange-200',
          'very-busy':'bg-red-100 border-red-200',
          unknown:    'bg-gray-50 border-gray-200 border-dashed',
        };
        const wkDot: Record<string, string> = {
          quiet:      'bg-emerald-500',
          moderate:   'bg-yellow-400',
          busy:       'bg-orange-500',
          'very-busy':'bg-red-500',
          unknown:    'bg-gray-300',
        };
        const _d = new Date();
        weekContainer.innerHTML = '';
        for (let i = 0; i < 14; i++) {
          const dd = new Date(_d);
          dd.setDate(_d.getDate() + i);
          const iso = `${dd.getFullYear()}-${String(dd.getMonth()+1).padStart(2,'0')}-${String(dd.getDate()).padStart(2,'0')}`;
          const dc = calls.find(c => c.date === iso);
          const dc_count = dc?.count ?? 0;
          const dc_level = levelFor(iso, dc);
          const bg = wkBg[dc_level] ?? wkBg.quiet;
          const dot = wkDot[dc_level] ?? wkDot.quiet;
          const dayNum = dd.getDate();
          const div = document.createElement('div');
          div.className = `flex flex-col items-center rounded-xl border p-3 min-w-[64px] text-center cursor-pointer ${bg}`;
          div.dataset.daySelect = iso;
          div.setAttribute('role', 'button');
          div.setAttribute('tabindex', '0');
          div.innerHTML = `
            <span class="text-xs font-medium text-gray-500 uppercase tracking-wide" data-i18n-weekday data-date="${iso}"></span>
            <span class="text-lg font-bold mt-0.5 ${dc_level === 'unknown' ? 'text-gray-400 line-through' : i === 0 ? 'text-gray-900' : 'text-gray-700'}">${dayNum}</span>
            <div class="flex flex-col items-center gap-1 mt-2">
              <div class="w-2.5 h-2.5 rounded-full ${dot}"></div>
              ${dc_count > 0 ? `<span class="text-[10px] text-gray-500" data-i18n-skipcount data-count="${dc_count}"></span>` : ''}
            </div>`;
          weekContainer.appendChild(div);
        }
      }

      // Update Calendar: move isPast shading and today ring to correct dates
      document.querySelectorAll<HTMLElement>('[data-cal-date]').forEach(el => {
        const d = el.dataset.calDate!;
        el.classList.toggle('opacity-40', d < todayStr);
        el.classList.toggle('ring-2',        d === todayStr);
        el.classList.toggle('ring-gray-800', d === todayStr);
        el.classList.toggle('ring-offset-1', d === todayStr);
      });

      // Re-apply language so all translated strings update
      applyLang(getLang());
    })();
  </script>
</body>
</html>
