    // ── Apply language ────────────────────────────────────────────────────────
    function applyLang(lang: Lang) {
      const t = T[lang] ?? T.en;
      localStorage.setItem('lang', lang);
      document.documentElement.lang = lang === 'en' ? 'en' : 'no';

      // Simple keyed translations
      const STATIC_KEYS: (keyof Strings)[] = [
        'subtitle','webcam','share','section_weather','section_14days',
        'section_bestdays','section_calendar','legend_quiet','legend_moderate',
        'legend_busy','legend_very_busy','footer_data','footer_credit',
        'level_quiet','level_moderate','level_busy','level_very_busy',
        'no_quiet_days','drawer_capacity_label','drawer_visitors_label','drawer_footnote',
        'badge_quiet','badge_moderate','badge_busy',
      ];
      STATIC_KEYS.forEach((key) => {
        document.querySelectorAll<HTMLElement>(`[data-i18n="${key}"]`).forEach((el) => {
          const val = t[key];
          if (typeof val === 'string') el.textContent = val;
        });
      });

      // Ships-in-port count
      document.querySelectorAll<HTMLElement>('[data-i18n-ships]').forEach((el) => {
        const n = parseInt(el.dataset.count ?? '0', 10);
        el.textContent = n === 0 ? t.ships_none : n === 1 ? t.ships_one : t.ships_many(n);
      });

      // Long date (StatusCard header)
      document.querySelectorAll<HTMLElement>('[data-i18n-date-long]').forEach((el) => {
        const d = new Date((el.dataset.date ?? '') + 'T12:00:00Z');
        el.textContent = d.toLocaleDateString(t.date_locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
      });

      // Short date (BestDays rows)
      document.querySelectorAll<HTMLElement>('[data-i18n-date-short]').forEach((el) => {
        const d = new Date((el.dataset.date ?? '') + 'T12:00:00Z');
        el.textContent = d.toLocaleDateString(t.date_locale, { weekday: 'short', day: 'numeric', month: 'short' });
      });

      // Weekday abbreviations in WeekView
      document.querySelectorAll<HTMLElement>('[data-i18n-weekday]').forEach((el) => {
        const d = new Date((el.dataset.date ?? '') + 'T12:00:00Z');
        el.textContent = d.toLocaleDateString(t.date_locale, { weekday: 'short' });
      });

      // Calendar weekday headers (Mon–Sun)
      document.querySelectorAll<HTMLElement>('[data-i18n-cal-weekday]').forEach((el) => {
        const idx = parseInt(el.dataset.wdIndex ?? '0', 10);
        el.textContent = t.weekdays[idx] ?? '';
      });

      // Calendar month labels
      document.querySelectorAll<HTMLElement>('[data-i18n-month]').forEach((el) => {
        const y = parseInt(el.dataset.year ?? '2026', 10);
        const m = parseInt(el.dataset.month ?? '1', 10);
        const d = new Date(Date.UTC(y, m - 1, 1));
        el.textContent = d.toLocaleDateString(t.month_locale, { month: 'long', year: 'numeric' });
      });

      // Ship count label in WeekView strips
      const shipWord: Record<Lang, (n: number) => string> = {
        en: (n) => `${n} ${n === 1 ? 'ship' : 'ships'}`,
        nb: (n) => `${n} skip`,
        nn: (n) => `${n} skip`,
        de: (n) => `${n} ${n === 1 ? 'Schiff' : 'Schiffe'}`,
        nl: (n) => `${n} ${n === 1 ? 'schip' : 'schepen'}`,
        fr: (n) => `${n} ${n === 1 ? 'navire' : 'navires'}`,
      };
      document.querySelectorAll<HTMLElement>('[data-i18n-skipcount]').forEach((el) => {
        const n = parseInt(el.dataset.count ?? '0', 10);
        el.textContent = shipWord[lang](n);
      });

      // BestDays reason strings
      document.querySelectorAll<HTMLElement>('[data-i18n-reason]').forEach((el) => {
        const n = parseInt(el.dataset.count ?? '0', 10);
        const v = parseInt(el.dataset.visitors ?? '0', 10);
        el.textContent = n === 0 ? t.best_quiet : n === 1 ? t.best_one(v) : t.best_many(n, v);
      });

      // BestDays badges
      document.querySelectorAll<HTMLElement>('[data-i18n-badge]').forEach((el) => {
        const level = el.dataset.level ?? '';
        el.textContent = level === 'quiet' ? t.badge_quiet : level === 'moderate' ? t.badge_moderate : t.badge_busy;
      });

      // Footer update timestamp
      const footerEl = document.getElementById('footer-updated');
      if (footerEl) {
        const days = parseInt(footerEl.dataset.days ?? '0', 10);
        const stale = footerEl.dataset.stale === 'true';
        const base = days === 0 ? t.footer_updated_today : t.footer_updated_ago(days);
        footerEl.textContent = base + (stale ? t.footer_stale : '');
      }
    }

    // ── Boot ──────────────────────────────────────────────────────────────────
    const initLang = (localStorage.getItem('lang') as Lang) ?? 'en';
    applyLang(initLang);

    window.addEventListener('langchange', (e) => {
      applyLang((e as CustomEvent<{ lang: Lang }>).detail.lang);
    });

    // ── Service worker ────────────────────────────────────────────────────────
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }

    // ── Share button ──────────────────────────────────────────────────────────
    const shareBtn = document.getElementById('share-btn');
    shareBtn?.addEventListener('click', async () => {
      const url = location.href;
      const lang = (localStorage.getItem('lang') as Lang) ?? 'en';
      const t = T[lang] ?? T.en;
      const shareSpan = shareBtn.querySelector<HTMLElement>('[data-i18n="share"]');
      if (navigator.share) {
        try { await navigator.share({ title: 'Visit Ålesund', url }); return; } catch {}
      }
      try {
        await navigator.clipboard.writeText(url);
        if (shareSpan) {
          const orig = shareSpan.textContent ?? '';
          shareSpan.textContent = t.link_copied;
          setTimeout(() => { shareSpan.textContent = orig; }, 2000);
        }
      } catch {}
    });

    // ── Deep link ─────────────────────────────────────────────────────────────
    const dateParam = new URLSearchParams(location.search).get('date');
    if (dateParam) {
      const el = document.querySelector(`a[href="?date=${dateParam}"]`);
      if (el) {
        el.classList.add('ring-2', 'ring-blue-500', 'ring-offset-1');
        setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
      }
    }

    // ── PWA install ───────────────────────────────────────────────────────────
    const INSTALL_I18N: Record<string, { title: string; hint: string; btn: string }> = {
      en: { title: 'Install app',        hint: 'Works offline · No app store needed',       btn: 'Install'     },
      nb: { title: 'Installer app',      hint: 'Fungerer uten nett · Ingen app-butikk',     btn: 'Installer'   },
      nn: { title: 'Installer app',      hint: 'Fungerer utan nett · Ingen app-butikk',     btn: 'Installer'   },
      de: { title: 'App installieren',   hint: 'Offline nutzbar · Kein App Store nötig',    btn: 'Installieren'},
      nl: { title: 'App installeren',    hint: 'Werkt offline · Geen app store nodig',      btn: 'Installeren' },
      fr: { title: "Installer l'appli",  hint: 'Fonctionne hors ligne · Sans app store',    btn: 'Installer'   },
    };

    const installBar   = document.getElementById('pwa-install-bar')!;
    const installBtn   = document.getElementById('pwa-install-btn') as HTMLButtonElement;
    const installTitle = document.getElementById('pwa-install-title')!;
    const installHint  = document.getElementById('pwa-install-hint')!;

    function setInstallStrings(lang: string) {
      const s = INSTALL_I18N[lang] ?? INSTALL_I18N.en;
      installTitle.textContent = s.title;
      installHint.textContent  = s.hint;
      installBtn.textContent   = s.btn;
    }
    setInstallStrings(initLang);
    window.addEventListener('langchange', (e) =>
      setInstallStrings((e as CustomEvent<{ lang: string }>).detail.lang)
    );

    // iOS: no beforeinstallprompt — show Share sheet guidance instead
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches
      || (navigator as any).standalone === true;
    const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent) && !isStandalone;
    if (isIOS) {
      installBar.hidden = false;
      installTitle.textContent = 'Add to Home Screen';
      installHint.textContent  = 'Tap Share  →  Add to Home Screen';
      installBtn.style.display = 'none';
    }

    // Chrome / Android / Edge: capture the native prompt
    let deferredPrompt: (Event & { prompt(): void; userChoice: Promise<{ outcome: string }> }) | null = null;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e as any;
      installBar.hidden = false;
      setInstallStrings(localStorage.getItem('lang') ?? 'en');
    });

    installBtn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      deferredPrompt = null;
      if (outcome === 'accepted') installBar.hidden = true;
    });

    window.addEventListener('appinstalled', () => {
      installBar.hidden = true;
      deferredPrompt = null;
    });

    // ── Live date refresh ─────────────────────────────────────────────────────
    // The static build captures "today" at deploy time. On subsequent days the
    // status card would show the wrong date until a rebuild. This fetches fresh
    // data from schedule.json and patches the DOM if the date has changed.
    (async () => {
      const _d = new Date();
      const todayStr = `${_d.getFullYear()}-${String(_d.getMonth() + 1).padStart(2, '0')}-${String(_d.getDate()).padStart(2, '0')}`;
      const dateEl = document.querySelector<HTMLElement>('[data-i18n-date-long]');
      if (!dateEl || dateEl.dataset.date === todayStr) return; // already correct

      let calls: Array<{ date: string; ships: string[]; count: number; level: string }> = [];
      try {
        const res = await fetch('/schedule.json');
        const data = await res.json();
        calls = data.calls ?? [];
      } catch { return; }

      const call = calls.find(c => c.date === todayStr);
      const ships   = call?.ships ?? [];
      const count   = call?.count ?? 0;
      const level   = (call?.level ?? 'quiet') as 'quiet' | 'moderate' | 'busy' | 'very-busy';

      const levelCfg = {
        quiet:       { bg: 'bg-emerald-50', ring: 'ring-emerald-200', dot: 'bg-emerald-500', text: 'text-emerald-700', key: 'level_quiet' },
        moderate:    { bg: 'bg-yellow-50',  ring: 'ring-yellow-200',  dot: 'bg-yellow-400',  text: 'text-yellow-700',  key: 'level_moderate' },
        busy:        { bg: 'bg-orange-50',  ring: 'ring-orange-200',  dot: 'bg-orange-500',  text: 'text-orange-700',  key: 'level_busy' },
        'very-busy': { bg: 'bg-red-50',     ring: 'ring-red-200',     dot: 'bg-red-500',     text: 'text-red-700',     key: 'level_very_busy' },
      } as const;
      const cfg = levelCfg[level];

      // Update date attribute (applyLang re-renders the formatted text)
      dateEl.dataset.date = todayStr;

      const section = document.querySelector<HTMLElement>('section.rounded-2xl');
      if (section) {
        // Background + ring
        ['bg-emerald-50','bg-yellow-50','bg-orange-50','bg-red-50',
         'ring-emerald-200','ring-yellow-200','ring-orange-200','ring-red-200']
          .forEach(c => section.classList.remove(c));
        section.classList.add(cfg.bg, cfg.ring);

        // Coloured circle
        const circle = section.querySelector<HTMLElement>('div.rounded-full.flex-shrink-0');
        if (circle) {
          ['bg-emerald-500','bg-yellow-400','bg-orange-500','bg-red-500']
            .forEach(c => circle.classList.remove(c));
          circle.classList.add(cfg.dot);
        }

        // Level heading
        const heading = section.querySelector<HTMLElement>('h2[data-i18n]');
        if (heading) {
          heading.dataset.i18n = cfg.key;
          ['text-emerald-700','text-yellow-700','text-orange-700','text-red-700']
            .forEach(c => heading.classList.remove(c));
          heading.classList.add(cfg.text);
        }

        // Ship count
        const countEl = section.querySelector<HTMLElement>('[data-i18n-ships]');
        if (countEl) countEl.dataset.count = String(count);

        // Ship chips
        section.querySelector('.flex.flex-wrap.gap-2')?.remove();
        if (ships.length > 0) {
          const div = document.createElement('div');
          div.className = 'flex flex-wrap gap-2';
          ships.forEach(ship => {
            const cap = getCapacity(ship);
            const btn = document.createElement('button');
            btn.className = 'ship-chip inline-flex items-center gap-1.5 rounded-full bg-white/70 backdrop-blur px-3 py-1.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-white transition min-h-[44px]';
            btn.dataset.ship = ship;
            btn.dataset.capacity = cap !== null ? String(cap) : '';
            btn.setAttribute('aria-label', `View details for ${ship}`);
            const capHtml = cap !== null
              ? `<span class="text-gray-400 text-xs">· ${(cap / 1000).toFixed(1)}k pax</span>`
              : '';
            btn.innerHTML = `<span>🚢</span><span>${ship}</span>${capHtml}`;
            div.appendChild(btn);
          });
          section.appendChild(div);
        }
      }

      // Re-apply language so all translated strings update
      applyLang((localStorage.getItem('lang') as Lang) ?? 'en');
    })();
  </script>
</body>
</html>
