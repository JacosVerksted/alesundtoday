---
// Fetches Ålesund 5-day weather from Yr.no at build time. Silently omitted if fetch fails.

interface HourEntry {
  time: string;
  data: {
    instant: { details: { air_temperature: number; wind_speed: number } };
    next_1_hours?: { summary: { symbol_code: string } };
    next_6_hours?: { summary: { symbol_code: string } };
    next_12_hours?: { summary: { symbol_code: string } };
  };
}

interface Forecast {
  date: string;
  temp: number;
  wind: number;
  symbol: string;
}

let forecasts: Forecast[] = [];

try {
  const res = await fetch(
    'https://api.met.no/weatherapi/locationforecast/2.0/compact?lat=62.4722&lon=6.1494',
    { headers: { 'User-Agent': 'visit-alesund/1.0 github.com/visit-alesund' } }
  );
  if (res.ok) {
    const json = await res.json();
    const timeseries: HourEntry[] = json.properties.timeseries;

    // Pick one reading per day at noon UTC
    const seen = new Set<string>();
    for (const entry of timeseries) {
      const dateStr = entry.time.slice(0, 10);
      const hour = parseInt(entry.time.slice(11, 13), 10);
      if (seen.has(dateStr) || hour !== 12) continue;
      seen.add(dateStr);

      const symbol =
        entry.data.next_1_hours?.summary.symbol_code ||
        entry.data.next_6_hours?.summary.symbol_code ||
        entry.data.next_12_hours?.summary.symbol_code ||
        'cloudy';

      forecasts.push({
        date: dateStr,
        temp: Math.round(entry.data.instant.details.air_temperature),
        wind: Math.round(entry.data.instant.details.wind_speed),
        symbol,
      });

      if (forecasts.length >= 7) break;
    }
  }
} catch {
  // Silently skip if weather unavailable
}

function symbolToEmoji(code: string): string {
  if (code.includes('clearsky') || code.includes('fair')) return '☀️';
  if (code.includes('partlycloudy')) return '⛅';
  if (code.includes('cloudy')) return '☁️';
  if (code.includes('rain') || code.includes('shower')) return '🌧️';
  if (code.includes('snow')) return '❄️';
  if (code.includes('sleet')) return '🌨️';
  if (code.includes('thunder')) return '⛈️';
  if (code.includes('fog')) return '🌫️';
  return '🌤️';
}
---

{forecasts.length > 0 && (
  <div class="overflow-x-auto -mx-4 px-4">
    <div class="flex gap-2 pb-2 min-w-max">
      {forecasts.map(f => {
        const d = new Date(f.date + 'T12:00:00Z');
        const dayName = d.toLocaleDateString('en-GB', { weekday: 'short' });
        return (
          <div class="flex flex-col items-center bg-sky-50 border border-sky-100 rounded-xl p-3 min-w-[64px] text-center">
            <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wide">{dayName}</span>
            <span class="text-2xl my-1">{symbolToEmoji(f.symbol)}</span>
            <span class="text-sm font-semibold text-gray-700">{f.temp}°</span>
            <span class="text-[10px] text-gray-400">{f.wind}m/s</span>
          </div>
        );
      })}
    </div>
  </div>
)}
