---
import type { DayInfo } from '../lib/schedule';

interface Props {
  days: DayInfo[];
}
const { days } = Astro.props;

const levelBg = {
  quiet:     'bg-emerald-100 border-emerald-200',
  moderate:  'bg-yellow-100 border-yellow-200',
  busy:      'bg-orange-100 border-orange-200',
  'very-busy': 'bg-red-100 border-red-200',
};

const levelDot = {
  quiet:     'bg-emerald-500',
  moderate:  'bg-yellow-400',
  busy:      'bg-orange-500',
  'very-busy': 'bg-red-500',
};
---

<div class="overflow-x-auto -mx-4 px-4">
  <div class="flex gap-2 pb-2 min-w-max">
    {days.map(day => {
      const d = new Date(day.date + 'T12:00:00Z');
      const dayName = d.toLocaleDateString('en-GB', { weekday: 'short' });
      const dayNum = d.getDate();
      const isToday = day.isToday;
      const bg = levelBg[day.level];

      return (
        <a
          href={`?date=${day.date}`}
          class={`flex flex-col items-center rounded-xl border p-3 min-w-[64px] text-center transition hover:scale-105 ${bg} ${isToday ? 'ring-2 ring-gray-800 ring-offset-1' : ''} ${day.isPast ? 'opacity-50' : ''}`}
          aria-label={`${day.date}: ${day.level}`}
        >
          <span class="text-xs font-medium text-gray-500 uppercase tracking-wide" data-i18n-weekday data-date={day.date}>{dayName}</span>
          <span class={`text-lg font-bold mt-0.5 ${isToday ? 'text-gray-900' : 'text-gray-700'}`}>{dayNum}</span>
          <div class="flex flex-col items-center gap-1 mt-2">
            <div class={`w-2.5 h-2.5 rounded-full ${levelDot[day.level]}`}></div>
            {day.count > 0 && (
              <span class="text-[10px] text-gray-500" data-i18n-skipcount data-count={day.count}>{day.count} ships</span>
            )}
          </div>
        </a>
      );
    })}
  </div>
</div>
