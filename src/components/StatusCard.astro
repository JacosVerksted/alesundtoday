---
import type { DayInfo } from '../lib/schedule';
import { getCapacity } from '../lib/ships';
import { portWindow, timeRange } from '../lib/visits';

interface Props {
  day: DayInfo;
}
const { day } = Astro.props;

const levelConfig = {
  quiet:     { label: 'Great time to visit',  color: 'bg-emerald-500', ring: 'ring-emerald-200', text: 'text-emerald-700', bg: 'bg-emerald-50', key: 'level_quiet' },
  moderate:  { label: 'Somewhat busy',        color: 'bg-yellow-400',  ring: 'ring-yellow-200',  text: 'text-yellow-700', bg: 'bg-yellow-50',  key: 'level_moderate' },
  busy:      { label: 'Quite busy',           color: 'bg-orange-500',  ring: 'ring-orange-200',  text: 'text-orange-700', bg: 'bg-orange-50',  key: 'level_busy' },
  'very-busy': { label: 'Very crowded',       color: 'bg-red-500',     ring: 'ring-red-200',     text: 'text-red-700',    bg: 'bg-red-50',     key: 'level_very_busy' },
  unknown:   { label: 'Schedule not available yet', color: 'bg-gray-300', ring: 'ring-gray-200', text: 'text-gray-500', bg: 'bg-gray-50', key: 'level_unknown' },
};

const cfg = levelConfig[day.level];

const isUnknown = day.level === 'unknown';
const visits = day.visits ?? [];
const inPortWindow = portWindow(visits);
const shipsText =
  isUnknown ? 'The port has not published ship arrivals for this day yet. Check back later.'
  : day.count === 0 ? 'No cruise ships in port'
  : day.count === 1 ? '1 cruise ship in port'
  : `${day.count} cruise ships in port`;
---

<section class={`rounded-2xl p-6 ${cfg.bg} ring-2 ${cfg.ring}`}>
  <div class="flex items-start justify-between gap-2 mb-1">
    <p
      class="text-sm font-medium text-gray-500"
      data-i18n-date-long
      data-date={day.date}
    >
      {new Date(day.date + 'T12:00:00Z').toLocaleDateString('en-GB', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
      })}
    </p>
    <button
      id="back-to-today"
      hidden
      class="flex-shrink-0 text-xs font-bold text-blue-600 hover:underline bg-white/70 rounded-full px-3 py-1.5 shadow-sm"
      data-i18n="back_to_today"
    >← Today</button>
  </div>

  <div class="flex items-center gap-4 mb-4">
    <div class={`w-14 h-14 rounded-full ${cfg.color} flex-shrink-0 shadow-md`}></div>
    <div>
      <p
        id="status-eyebrow"
        hidden
        class="text-xs font-bold uppercase tracking-wide text-gray-500 mb-0.5"
        data-i18n="will_be"
      >It will be</p>
      <h2 class={`text-2xl font-bold ${cfg.text}`} data-i18n={cfg.key}>{cfg.label}</h2>
      {isUnknown
        ? <p class="text-gray-600 text-sm" data-i18n="unknown_note">{shipsText}</p>
        : <p class="text-gray-600 text-sm" data-i18n-ships data-count={day.count}>{shipsText}</p>}
      <p
        id="status-inport"
        class="text-gray-700 text-sm font-medium mt-0.5"
        hidden={!inPortWindow}
        data-i18n-inport
        data-window={inPortWindow}
      >{inPortWindow ? `In port ${inPortWindow}` : ''}</p>
    </div>
  </div>

  {day.ships.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {day.ships.map(ship => {
        const cap = getCapacity(ship);
        return (
          <button
            class="ship-chip inline-flex items-center gap-1.5 rounded-full bg-white/70 backdrop-blur px-3 py-1.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-white transition min-h-[44px]"
            data-ship={ship}
            data-capacity={cap !== null ? String(cap) : ''}
            aria-label={`View details for ${ship}`}
          >
            <span>🚢</span>
            <span>{ship}</span>
            {cap !== null && (
              <span class="text-gray-400 text-xs">·&nbsp;{(cap/1000).toFixed(1)}k pax</span>
            )}
          </button>
        );
      })}
    </div>
  )}

  {visits.length > 0 && (
    <ul class="visit-times mt-3 space-y-1 text-sm text-gray-600">
      {visits.map(v => (
        <li>
          <span class="font-medium tabular-nums text-gray-700">{timeRange(v.eta, v.etd)}</span>
          <span> {v.ship}</span>
          <span class="text-gray-400"> · {v.bay}</span>
        </li>
      ))}
    </ul>
  )}
</section>
